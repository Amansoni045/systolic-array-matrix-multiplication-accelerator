# Compiled simulation executables and build outputs
*.out
*.vvp
*.o
*.obj
*.exe
*.bin
*.hex
*_sim
simulation/*_sim
simulation/*.vvp

# Waveform dump files
*.vcd
*.fst
*.ghw
simulation/waveforms/*
!simulation/waveforms/.gitkeep

# Simulation logs and run results
*.log
simulation/results/*
!simulation/results/.gitkeep

# Python cache and environment files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.env
.venv/
env/
venv/

# Operating system temporary files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
*~
*.swp
*.swo

# Preserve empty directory tracking
!.gitkeep
